# Local PostgreSQL Docker configuration
POSTGRES_DB=school_management
POSTGRES_USER=school_app
POSTGRES_PASSWORD=CHANGE_ME_LOCAL
POSTGRES_PORT=5433

# Spring Boot database connection
DB_URL=jdbc:postgresql://localhost:5433/school_management
DB_USERNAME=school_app
DB_PASSWORD=CHANGE_ME_LOCAL
DB_POOL_SIZE=5
DB_MIN_IDLE=0

# Generate a fresh Base64-encoded random 32-byte value for each environment.
JWT_SECRET=REPLACE_WITH_GENERATED_BASE64_SECRET

# Local backend port and allowed local frontend origin
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Private assessment administrator password (never commit or expose in the frontend).
# Use a unique random value of 16-72 UTF-8 bytes in each environment.
DEMO_ADMIN_PASSWORD=
